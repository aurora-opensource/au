"""
The doc website's sources.

`mkdocs` builds this directory into the site (it is the default `docs_dir`).  The single-file
packages published alongside it are release artifacts; they are generated in `//release` and copied
into the site by a `mkdocs` hook.
"""

################################################################################
# The doc website's sources, for `//tools/docs`, which can't glob them from there.

# Glob what we need while avoiding a recursive glob.
filegroup(
    name = "doc_sources",
    srcs = glob([
        "*.css",
        "*.md",
        "alternatives/*.md",
        "assets/*",
        "discussion/*.md",
        "discussion/concepts/*.md",
        "discussion/idioms/*.md",
        "discussion/implementation/*.md",
        "examples/*.md",
        "howto/*.md",
        "howto/interop/*.md",
        "reference/*.md",
        "reference/detail/*.md",
        "tutorial/*.md",
        "tutorial/exercise/*.md",
    ]),
    visibility = ["//tools/docs:__pkg__"],
)
