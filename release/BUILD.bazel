################################################################################
# The single-file packages.

BASE_UNITS = [
    "meters",
    "seconds",
    "grams",
    "kelvins",
    "amperes",
    "moles",
    "candelas",
    "radians",
    "bits",
    "unos",
]

BASE_UNIT_STRING = " ".join(BASE_UNITS)

GIT_ID_CMD = " | ".join([
    "cat bazel-out/stable-status.txt",
    "grep STABLE_GIT_ID",
    "sed 's/STABLE_GIT_ID \\(.*\\)/\\1/'",
    "tr -d '\\n'",
])

CMD_ROOT = " ".join([
    "$(execpath //:tools/bin/make-single-file)",
    "{extra_opts}",
    "{units}",
    "{all_literals}",
    "{all_constants}",
    "--version-id $$({id_cmd})",
    "> $(OUTS)",
])

################################################################################
# Release single-file package `au.hh`

genrule(
    name = "au_hh",
    srcs = ["//au:headers"],
    outs = ["au.hh"],
    cmd = CMD_ROOT.format(
        all_constants = "",
        all_literals = "",
        extra_opts = "",
        id_cmd = GIT_ID_CMD,
        units = "--units " + BASE_UNIT_STRING,
    ),
    stamp = True,
    tools = ["//:tools/bin/make-single-file"],
    visibility = ["//tools/docs:__pkg__"],
)

################################################################################
# Release single-file package `au_noio.hh`

genrule(
