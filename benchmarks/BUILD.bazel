load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "compile_benchmark")

# Compile time benchmarks.
#
# Each benchmark exists to give us visibility into some particular sensitivity we expect to have.
#
# This package is patterned off of our code examples, which we also use for compile time benchmarks.
# However, not every sensitivity makes sense as a code example.  So we made this package, and gave
# it the same shape as the examples, in order to make it as easy as possible to reuse the machinery.
#
# Benchmarks that probe the same sensitivity at different sizes share a folder, one file each.  The
# measurement tooling groups translation units by folder, so this is what puts related benchmarks
# side by side in the plots.

compile_benchmark(
    name = "si_base_units",
    srcs = ["includes/si_base_units.cc"],
    deps = ["//au:units"],
)

compile_benchmark(
    name = "common_units",
    srcs = ["includes/common_units.cc"],
    deps = ["//au:units"],
)

compile_benchmark(
    name = "all_units",
    srcs = ["includes/all_units.cc"],
    deps = ["//au:units"],
)

compile_benchmark(
    name = "kinematics_aliases",
    srcs = [
        "aliases/kinematics.cc",
        "aliases/kinematics.hh",
    ],
    deps = ["//au:units"],
)

compile_benchmark(
    name = "common_aliases",
    srcs = [
        "aliases/common.cc",
        "aliases/common.hh",
    ],
    deps = ["//au:units"],
)

sh_test(
    name = "all_units_listing_test",
    size = "small",
    srcs = ["check_all_units_listing.sh"],
    args = ["$(rootpath includes/all_units.cc)"],
    data = [
        "includes/all_units.cc",
        "//au:headers",
    ],
)
