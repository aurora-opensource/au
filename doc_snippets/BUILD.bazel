"""
Reusable prose snippets, included by the doc pages via `--8<-- "file.md"`.

They live outside `docs/` because `mkdocs.yml` lists this directory in the `pymdownx.snippets`
`base_path`, so the pages can pull them in without them becoming pages of their own.
"""

filegroup(
    name = "snippets",
    srcs = glob(["*.md"]),
    visibility = ["//tools/docs:__pkg__"],
)
