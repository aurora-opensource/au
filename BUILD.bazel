# Au's consumers load this package whenever one of their targets refers to a file in it, so it may
# only load rules they are guaranteed to have: native rules, and `rules_cc`.  Anything that needs a
# `dev_dependency` (`rules_python`, `rules_shell`, our pip hub, etc.) belongs in another package,
# such as`//tools/docs` or `//release`.  Our workspace/module export tests will catch failures.

# The README quotes code from `//examples`, and `//examples:readme_snippets_test` checks that those
# copies still match their source.
exports_files(["README.md"])

exports_files(
    [
        "requirements.in",
        "requirements_lock.txt",
    ],
    visibility = ["//tools/docs:__pkg__"],
)

# `mkdocs` looks for this in the root of its runfiles, so it stays here.
exports_files(
    ["mkdocs.yml"],
    visibility = ["//tools/docs:__pkg__"],
)

# The single-file genrules in `//release` run this script.
exports_files(
    ["tools/bin/make-single-file"],
    visibility = ["//release:__pkg__"],
)
