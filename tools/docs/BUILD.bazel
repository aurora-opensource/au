"""
Tooling for the doc website.
"""

load("@au_pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# This rule adds a convenient way to update the requirements file.
compile_pip_requirements(
    name = "requirements",
    requirements_in = "//:requirements.in",
    requirements_txt = "//:requirements_lock.txt",
)

# Everything `mkdocs` reads while building the site, plus the packages the publishing hook copies in.
filegroup(
    name = "site_inputs",
    srcs = [
        "//:mkdocs.yml",
        "//doc_snippets:snippets",
        "//docs:doc_sources",
        "//examples:doc_sources",
        "//release:au_all_units_hh",
        "//release:au_all_units_noio_hh",
        "//release:au_all_units_stdformat_hh",
        "//release:au_all_units_stdformat_noio_hh",
        "//release:au_hh",
        "//release:au_noio_hh",
        "//release:au_stdformat_hh",
        "//release:au_stdformat_noio_hh",
    ],
)

# The `mkdocs` hook that copies the single-file packages into the site.  `mkdocs` loads it by path
# (see `mkdocs.yml`), but the test imports it as a module.  `imports = ["."]` puts this directory on
# `sys.path`; we can't rely on Python adding the script's directory, because `rules_python` sets
# `PYTHONSAFEPATH`, which Python 3.11+ honors.
py_library(
    name = "publish_single_file_packages",
    srcs = ["publish_single_file_packages.py"],
    data = [":site_inputs"],
    imports = ["."],
    deps = [requirement("mkdocs")],
)

# Both binaries run from the root of their runfiles, which is where `mkdocs` looks for
# `mkdocs.yml`; that is why the doc sources stay in the root package.
py_binary(
    name = "update_docs",
    srcs = ["update_docs.py"],
    data = [":site_inputs"],
    deps = [
        ":publish_single_file_packages",
        requirement("mkdocs"),
        requirement("mkdocs-material"),
    ],
)

py_binary(
    name = "mike",
    srcs = ["mike_bin.py"],
    data = [":site_inputs"],
    main = "mike_bin.py",
    deps = [
        ":update_docs",
        requirement("mike"),
        requirement("mkdocs"),
        requirement("mkdocs-material"),
    ],
)

# The packages are copied into the site by a `mkdocs` hook, so nothing else would notice if that
# stopped working: the site would build and deploy without them.
py_test(
    name = "publish_single_file_packages_test",
    size = "small",
    srcs = ["publish_single_file_packages_test.py"],
    data = [":site_inputs"],
    deps = [
        ":publish_single_file_packages",
        requirement("mkdocs"),
        requirement("mkdocs-material"),
    ],
)
