load("@au_pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "compile_time_data",
    srcs = ["compile_time_data.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "compile_time_data_test",
    size = "small",
    srcs = ["compile_time_data_test.py"],
    deps = [":compile_time_data"],
)

py_library(
    name = "csv_stream",
    srcs = ["csv_stream.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "csv_stream_test",
    size = "small",
    srcs = ["csv_stream_test.py"],
    deps = [":csv_stream"],
)

# Plots for a `measure-compile-time` run.  Unlike the harness in `tools/bin`, this is not something
# to run by hand: matplotlib is a pinned dependency, and bazel is what supplies it.
py_binary(
    name = "plot_compile_time",
    srcs = ["plot_compile_time.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":compile_time_data",
        requirement("matplotlib"),
    ],
)
