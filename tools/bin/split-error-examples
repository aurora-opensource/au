"""Split `au/error_examples.cc` into one file per SECTION, for isolated compilation.

Each output file contains exactly one section's code; every other section's lines are replaced with
blank lines, so that line numbers match the original file exactly.  With `--single-file`, the
`#include "au/..."` block is replaced by a single `#include "au.hh"` (padded with blank lines, again
to preserve line numbers), for use with the single-file package that MSVC builds consume.
"""
import argparse
import os
import re

BAR = "/" * 100


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", default=os.path.join("au", "error_examples.cc"))
    parser.add_argument("--outdir", default="sections")
    parser.add_argument("--single-file", action="store_true")
    args = parser.parse_args()

    lines = open(args.input).read().split("\n")

    if args.single_file:
        includes = [i for i, l in enumerate(lines) if l.startswith('#include "au')]
        for i in includes:
            lines[i] = ""
        lines[includes[0]] = '#include "au.hh"'

    starts = [i for i, l in enumerate(lines) if l.startswith(BAR)]
    names = [lines[i + 1].replace("// SECTION: ", "") for i in starts]
    end = next(i for i, l in enumerate(lines) if l.startswith("}  // namespace au"))
    bounds = [(starts[k], starts[k + 1] if k + 1 < len(starts) else end) for k in range(len(starts))]

    os.makedirs(args.outdir, exist_ok=True)
    for k, (name, _) in enumerate(zip(names, bounds)):
        out = list(lines)
        for j, (c, d) in enumerate(bounds):
            if j != k:
                for i in range(c, d):
                    out[i] = ""
        slug = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
        path = os.path.join(args.outdir, f"{k:02d}_{slug}.cc")
        open(path, "w").write("\n".join(out))
        print(path)


if __name__ == "__main__":
    main()
